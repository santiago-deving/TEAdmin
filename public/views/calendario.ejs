<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEAdm - Calendário</title>

    <link rel="stylesheet" href="/css/global.css"/>
    <link rel="stylesheet" href="/css/calendario.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>

    <style>
        .fc { font-family: 'Segoe UI', sans-serif; font-size: 0.9rem; }
        .fc-toolbar-title { font-size: 1.1rem !important; color: var(--azul) !important; font-weight: 700 !important; text-transform: capitalize; }
        .fc-button { background-color: var(--cinza-claro) !important; border: none !important; color: var(--azul) !important; border-radius: 8px !important; font-size: 1rem !important; padding: 4px 12px !important; transition: background 0.2s !important; }
        .fc-button:hover { background-color: #dde !important; }
        .fc-button-active { background-color: var(--azul) !important; color: #fff !important; }
        .fc-daygrid-day-number { color: var(--cinza-texto); }
        .fc-col-header-cell-cushion { color: var(--azul); font-weight: 700; font-size: 0.78rem; }
        .fc-event { border-radius: 6px !important; padding: 2px 6px !important; cursor: pointer; }
        .fc-event-title { font-size: 0.78rem; font-weight: 600; }
        .fc-day-today { background-color: rgba(46, 134, 171, 0.08) !important; }
        .painel-container { max-width: 1100px; margin: 40px auto; padding: 0 24px; }
        .toast {
            position: fixed; bottom: 32px; right: 32px;
            background: #222; color: #fff;
            padding: 14px 24px; border-radius: 12px;
            font-size: 0.9rem; font-weight: 600;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            opacity: 0; transform: translateY(20px);
            transition: all 0.3s ease;
            z-index: 9999; pointer-events: none;
        }
        .toast.show { opacity: 1; transform: translateY(0); }
        .toast.sucesso { border-left: 5px solid #4CAF50; }
        .toast.erro    { border-left: 5px solid #E76F51; }
        .modal-overlay {
            display: none; position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 2000; justify-content: center; align-items: center;
        }
        .modal-overlay.ativo { display: flex; }
        .modal {
            background: #fff; border-radius: 16px;
            padding: 32px; width: 400px; max-width: 90%;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        }
        .modal h3 { color: var(--azul); margin-bottom: 20px; font-size: 1.1rem; }
        .modal-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
        .modal-group label { font-size: 0.82rem; font-weight: 700; color: #666; text-transform: uppercase; }
        .modal-group input, .modal-group select {
            padding: 10px 14px; border: 1.5px solid #ddd;
            border-radius: 10px; font-size: 0.9rem; outline: none;
        }
        .modal-group input:focus, .modal-group select:focus { border-color: var(--azul); }
        .modal-acoes { display: flex; justify-content: flex-end; gap: 12px; margin-top: 8px; }
        .btn-confirmar {
            background-color: var(--azul); color: #fff; border: none;
            border-radius: 10px; padding: 10px 24px;
            font-size: 0.9rem; font-weight: 700; cursor: pointer;
        }
        .btn-fechar {
            background: transparent; border: 1.5px solid #ddd;
            border-radius: 10px; padding: 10px 20px;
            font-size: 0.9rem; cursor: pointer; color: #666;
        }
    </style>
</head>
<body>

    <div class="overlay" id="overlay"></div>

    <div class="sidebar" id="sidebar">
        <div class="closeBtn" id="closeBtn">
            <i class="bi bi-x"></i>
        </div>
        <nav>
            <ul>
                <li><a href="/painel_admin">Painel Administrativo</a></li>
                <li><a href="/painel_pais">Acompanhamento</a></li>
                <li><a href="/calendario">Calendário</a></li>
                <li><a href="/cadastro-paciente">Cadastro de Paciente</a></li>
                <li><a href="/cadastro-responsavel">Cadastro de Responsável</a></li>
                <li><a href="#">Dados</a></li>
            </ul>
        </nav>
    </div>

    <!-- MODAL -->
    <div class="modal-overlay" id="modal-overlay">
        <div class="modal">
            <h3 id="modal-titulo">📅 Agendamento</h3>
            <div class="modal-group">
                <label>Data</label>
                <input type="text" id="modal-data" readonly>
            </div>
            <div class="modal-group">
                <label>Nome do Paciente</label>
                <input type="text" id="modal-paciente" placeholder="Nome do paciente">
            </div>
            <div class="modal-group">
                <label>Horário</label>
                <input type="time" id="modal-hora">
            </div>
            <div class="modal-acoes">
                <button class="btn-fechar" onclick="fecharModal()">Cancelar</button>
                <button class="btn-confirmar" onclick="confirmarAgendamento()">Confirmar</button>
            </div>
        </div>
    </div>

    <!-- BARRA DE ACESSIBILIDADE -->
    <div class="barra-acessibilidade" role="toolbar" aria-label="Ferramentas de acessibilidade">
        <span>Acessibilidade:</span>
        <button class="btn-acess" onclick="diminuirFonte()" aria-label="Diminuir fonte">A-</button>
        <button class="btn-acess" onclick="aumentarFonte()" aria-label="Aumentar fonte">A+</button>
        <button class="btn-acess" id="btn-contraste" onclick="alternarContraste()" aria-label="Alternar alto contraste">◑ Contraste</button>
        <button class="btn-acess" id="btn-voz" onclick="alternarVoz()" aria-label="Ativar leitura de tela">🔊 Leitura de voz</button>
        <button class="btn-acess" onclick="abrirLibras()" aria-label="Abrir intérprete de Libras">🤟 Libras</button>
    </div>

    <!-- HEADER -->
    <div class="header">
        <div class="menu_btn" id="menu_btn">
            <i class="bi bi-list"></i>
        </div>
        <div class="header-logo">
            <h1><span class="te">TE</span><span style="color:#fff">Adm</span></h1>
        </div>
        <div class="header-info">
            <span>Calendário de Consultas</span>
            <a href="/logout" class="btn-sair">Sair</a>
        </div>
    </div>

    <!-- CONTEÚDO -->
    <div class="painel-container">
        <div class="card-secao">
            <div class="secao-header">
                <h2>📅 Agenda de Terapias</h2>
                <span class="data-badge" id="data-hoje"></span>
            </div>
            <div id="calendar"></div>
        </div>
    </div>

    <script src="/js/acessibilidade.js"></script>
    <script src="/js/calendario.js"></script>

    <div class="toast" id="toast"></div>
</body>
</html>