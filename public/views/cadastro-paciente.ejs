<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEAdm - Cadastro de Paciente</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/cadastro-paciente.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="overlay" id="overlay"></div>

    <div class="sidebar" id="sidebar">
        <div class="closeBtn" id="closeBtn"><i class="bi bi-x"></i></div>
        <nav>
            <ul>
                <li><a href="/painel_admin">Painel Administrativo</a></li>
                <li><a href="/painel_pais">Acompanhamento</a></li>
                <li><a href="/calendario">Calendário</a></li>
                <li><a href="/cadastro-paciente">Cadastro de Paciente</a></li>
                <li><a href="/cadastro-responsavel">Cadastro de Responsável</a></li>
                <li><a href="#">Dados</a></li>
            </ul>
        </nav>
    </div>

    <div class="barra-acessibilidade" role="toolbar" aria-label="Ferramentas de acessibilidade">
        <span>Acessibilidade:</span>
        <button class="btn-acess" onclick="diminuirFonte()" aria-label="Diminuir fonte">A-</button>
        <button class="btn-acess" onclick="aumentarFonte()" aria-label="Aumentar fonte">A+</button>
        <button class="btn-acess" id="btn-contraste" onclick="alternarContraste()" aria-label="Alternar alto contraste">◑ Contraste</button>
        <button class="btn-acess" id="btn-voz" onclick="alternarVoz()" aria-label="Ativar leitura de tela">🔊 Leitura de tela</button>
        <button class="btn-acess" onclick="abrirLibras()" aria-label="Abrir intérprete de Libras">🤟 Libras</button>
    </div>

    <header class="header">
        <div class="menu_btn" id="menu_btn"><i class="bi bi-list"></i></div>
        <div class="header-logo">
            <h1><span class="te">TE</span><span class="adm">Adm</span></h1>
        </div>
        <div class="header-info">
            <span>⚙️ Admin: <span id="nome-admin">...</span></span>
            <a href="/logout" class="btn-sair">Sair</a>
        </div>
    </header>

    <main class="painel-container">

        <div class="boas-vindas">
            <h2>👦 Cadastro de Paciente</h2>
            <p>Preencha os dados abaixo para cadastrar um novo paciente na clínica</p>
        </div>

        <div class="form-wrapper">

            <section class="card-secao">
                <div class="secao-header"><h2>📋 Dados Pessoais</h2></div>
                <div class="form-grid">

                    <!-- Nome e Sobrenome separados -->
                    <div class="form-group">
                        <label for="nome">Nome *</label>
                        <input type="text" id="nome" name="nome" placeholder="Nome do paciente" required>
                    </div>
                    <div class="form-group">
                        <label for="sobrenome">Sobrenome *</label>
                        <input type="text" id="sobrenome" name="sobrenome" placeholder="Sobrenome do paciente" required>
                    </div>

                    <div class="form-group">
                        <label for="data_nascimento">Data de Nascimento *</label>
                        <input type="date" id="data_nascimento" name="data_nascimento" required>
                    </div>
                    <div class="form-group">
                        <label for="cpf">CPF</label>
                        <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14">
                    </div>
                    <div class="form-group">
                        <label for="sexo">Sexo *</label>
                        <select id="sexo" name="sexo" required>
                            <option value="">Selecione...</option>
                            <option value="M">Masculino</option>
                            <option value="F">Feminino</option>
                            <option value="O">Outro</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="diagnostico">Diagnóstico</label>
                        <input type="text" id="diagnostico" name="diagnostico" placeholder="Ex: TEA nível 1, TDAH...">
                    </div>
                    <div class="form-group">
                        <label for="terapeuta">Terapeuta Responsável</label>
                        <select id="terapeuta" name="terapeuta_id">
                            <option value="">Selecione um terapeuta...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="status">Status</label>
                        <select id="status" name="status">
                            <option value="ativo">Ativo</option>
                            <option value="aguardando">Aguardando Agendamento</option>
                            <option value="inativo">Inativo</option>
                        </select>
                    </div>
                </div>
            </section>

            <section class="card-secao">
                <div class="secao-header"><h2>📞 Contato</h2></div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="telefone">Telefone</label>
                        <input type="text" id="telefone" name="telefone" placeholder="(00) 00000-0000" maxlength="15">
                    </div>
                    <div class="form-group">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" placeholder="email@exemplo.com">
                    </div>
                </div>
            </section>

            <section class="card-secao">
                <div class="secao-header"><h2>📍 Endereço</h2></div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="cep">CEP</label>
                        <input type="text" id="cep" name="cep" placeholder="00000-000" maxlength="9">
                    </div>
                    <div class="form-group span-2">
                        <label for="logradouro">Logradouro</label>
                        <input type="text" id="logradouro" name="logradouro" placeholder="Rua, Avenida...">
                    </div>
                    <div class="form-group">
                        <label for="numero">Número</label>
                        <input type="text" id="numero" name="numero" placeholder="Nº">
                    </div>
                    <div class="form-group">
                        <label for="complemento">Complemento</label>
                        <input type="text" id="complemento" name="complemento" placeholder="Apto, Bloco...">
                    </div>
                    <div class="form-group">
                        <label for="bairro">Bairro</label>
                        <input type="text" id="bairro" name="bairro" placeholder="Bairro">
                    </div>
                    <div class="form-group">
                        <label for="cidade">Cidade</label>
                        <input type="text" id="cidade" name="cidade" placeholder="Cidade">
                    </div>
                    <div class="form-group">
                        <label for="estado">Estado</label>
                        <select id="estado" name="estado">
                            <option value="">UF</option>
                            <option>AC</option><option>AL</option><option>AP</option><option>AM</option>
                            <option>BA</option><option>CE</option><option>DF</option><option>ES</option>
                            <option>GO</option><option>MA</option><option>MT</option><option>MS</option>
                            <option>MG</option><option>PA</option><option>PB</option><option>PR</option>
                            <option>PE</option><option>PI</option><option>RJ</option><option>RN</option>
                            <option>RS</option><option>RO</option><option>RR</option><option>SC</option>
                            <option>SP</option><option>SE</option><option>TO</option>
                        </select>
                    </div>
                </div>
            </section>

            <section class="card-secao">
                <div class="secao-header"><h2>🏥 Plano de Saúde</h2></div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="plano_nome">Nome do Plano</label>
                        <input type="text" id="plano_nome" name="plano_nome" placeholder="Ex: Unimed, Bradesco Saúde...">
                    </div>
                    <div class="form-group">
                        <label for="plano_numero">Número da Carteirinha</label>
                        <input type="text" id="plano_numero" name="plano_numero" placeholder="Número do beneficiário">
                    </div>
                    <div class="form-group">
                        <label for="plano_validade">Validade</label>
                        <input type="date" id="plano_validade" name="plano_validade">
                    </div>
                </div>
            </section>

            <section class="card-secao">
                <div class="secao-header"><h2>📝 Observações</h2></div>
                <div class="form-grid">
                    <div class="form-group span-full">
                        <label for="observacoes">Observações Clínicas / Informações Adicionais</label>
                        <textarea id="observacoes" name="observacoes" rows="5" placeholder="Informações relevantes sobre o paciente..."></textarea>
                    </div>
                </div>
            </section>

            <div class="form-acoes">
                <button type="button" class="btn-cancelar" onclick="window.history.back()">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </button>
                <button type="button" class="btn-salvar" onclick="salvarPaciente()">
                    <i class="bi bi-check-lg"></i> Cadastrar Paciente
                </button>
            </div>

        </div>
    </main>

    <div class="toast" id="toast"></div>

    <script src="/js/acessibilidade.js"></script>
    <script src="/js/cadastro-paciente.js"></script>
    <script>
        const menuBtn = document.getElementById('menu_btn');
        const sidebar = document.getElementById('sidebar');
        const closeBtn = document.getElementById('closeBtn');
        const overlay = document.getElementById('overlay');
        menuBtn.addEventListener('click',  () => { sidebar.classList.add('aberto');    overlay.classList.add('ativo'); });
        closeBtn.addEventListener('click', () => { sidebar.classList.remove('aberto'); overlay.classList.remove('ativo'); });
        overlay.addEventListener('click',  () => { sidebar.classList.remove('aberto'); overlay.classList.remove('ativo'); });
    </script>
</body>
</html>
